{
  "name": "@necrohex/web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "sample": "node scripts/fetch-freedoom.ts",
    "dev": "node scripts/fetch-freedoom.ts && vite --port 5173 --strictPort",
    "build": "node scripts/fetch-freedoom.ts && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest --run",
    "screenshots": "node scripts/screenshots.ts"
  },
  "dependencies": {
    "@necrohex/adapter-wad": "workspace:*",
    "@necrohex/core": "workspace:*",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "playwright-core": "1.65.0",
    "vite": "7.3.7",
    "vue-tsc": "3.3.14"
  }
}
